<?xml version="1.0" encoding="utf-8"?>
<!--
  A release build that runs on a machine without .NET installed: the runtime ships inside the executable.
    dotnet publish src/Herculan.Engine.Host -p:PublishProfile=win-x64
  The native libraries (GLFW, OpenAL Soft, cimgui), the Localization folder and the ImGui font stay loose
  beside the executable: the .lang files are meant to be edited after install, and Silk.NET finds its
  native libraries next to the executable without any extraction step.
  Untrimmed: System.Text.Json and the COM folder picker both rely on reflection the trimmer cannot see.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
