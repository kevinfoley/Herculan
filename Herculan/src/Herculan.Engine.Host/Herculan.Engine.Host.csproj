<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window of its own; HostLog attaches to a terminal it is started from, and keeps a log. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Herculan.Engine.Host</RootNamespace>
    <AssemblyName>Herculan</AssemblyName>
    <!-- The name Windows shows in Explorer's file properties and Task Manager. -->
    <AssemblyTitle>HERCULAN Engine</AssemblyTitle>
    <!-- The icon Explorer and shortcuts show for the exe. The artwork is not MIT-licensed; see Branding/README.md. -->
    <ApplicationIcon>..\..\..\Branding\HE Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Herculan.Engine\Herculan.Engine.csproj" />
    <ProjectReference Include="..\HercWorks.Help\HercWorks.Help.csproj" />
  </ItemGroup>

  <!-- Linked from the editor host rather than copied: one font file, two hosts. -->
  <ItemGroup>
    <None Include="..\Herculan.Engine.Host.Editor\Assets\Fonts\Open_Sans\static\OpenSans-Regular.ttf" Link="Assets\Fonts\Open_Sans\static\OpenSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The window icon (WindowIcon), linked from Branding/ like the font above: loose files, since the artwork is not
       MIT-licensed and stays covered by Branding/README.md. -->
  <ItemGroup>
    <None Include="..\..\..\Branding\HE Icon *.png" LinkBase="Assets\Icon" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Loose files, not EmbeddedResource: Localization scans this folder at runtime, so a player can
       drop in their own .lang file (a new locale, or edits to an existing one) after install without
       rebuilding anything. -->
  <ItemGroup>
    <None Update="Localization\*.lang" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
