<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window of its own; HostLog attaches to a terminal it is started from, and keeps a log. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Herculan.Engine.Host</RootNamespace>
    <AssemblyName>Herculan</AssemblyName>
    <!-- The name Windows shows in Explorer's file properties and Task Manager. -->
    <AssemblyTitle>HERCULAN Engine</AssemblyTitle>
    <!-- The icon Explorer and shortcuts show for the exe. The artwork is not MIT-licensed; see Branding/README.md. -->
    <ApplicationIcon>..\..\..\Branding\HE Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Herculan.Engine\Herculan.Engine.csproj" />
    <ProjectReference Include="..\Herculan.Es1\Herculan.Es1.csproj" />
    <ProjectReference Include="..\HercWorks.Help\HercWorks.Help.csproj" />
    <ProjectReference Include="..\Herculan.Es2.Editor\Herculan.Es2.Editor.csproj" />
    <ProjectReference Include="..\Herculan.Es2\Herculan.Es2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herculan.Engine.Host.Tests" />
  </ItemGroup>

  <!-- Linked from the editor host rather than copied: one font file, two hosts. -->
  <ItemGroup>
    <None Include="..\Herculan.Es2.Host.Editor\Assets\Fonts\Open_Sans\static\OpenSans-Regular.ttf" Link="Assets\Fonts\Open_Sans\static\OpenSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Herculan.Es2.Host.Editor\Assets\Fonts\Open_Sans\static\OpenSans-Italic.ttf" Link="Assets\Fonts\Open_Sans\static\OpenSans-Italic.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Herculan.Es2.Host.Editor\Assets\Fonts\Open_Sans\static\OpenSans-Bold.ttf" Link="Assets\Fonts\Open_Sans\static\OpenSans-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- The font's licence, which the OFL requires to travel with the font. -->
    <None Include="..\Herculan.Es2.Host.Editor\Assets\Fonts\Open_Sans\OFL.txt" Link="Assets\Fonts\Open_Sans\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The notices of the third-party components the engine ships (OpenAL Soft, GLFW, cimgui, Silk.NET and others),
       a file of its own beside the executable in every build and publish. -->
  <ItemGroup>
    <None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The window icon (WindowIcon), linked from Branding/ like the font above: loose files, since the artwork is not
       MIT-licensed and stays covered by Branding/README.md. -->
  <ItemGroup>
    <None Include="..\..\..\Branding\HE Icon *.png" LinkBase="Assets\Icon" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The missions that come with HERCULAN (CustomMissions.IncludedFolder), from Herculan/missions/; the editor's File >
       Export Mission Bundle writes one there. The editor host, which references this project, gets them beside its own
       executable too. -->
  <ItemGroup>
    <None Include="..\..\missions\*.hcm" LinkBase="Missions" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The LGPL OPL emulator stays a file of its own beside the executable in a single-file publish, so that a recipient can
       replace it with a modified copy, as the LGPL requires (Herculan.Opl3.csproj). -->
  <Target Name="KeepOpl3OutOfSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'Herculan.Opl3.dll'" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!-- Loose files, not EmbeddedResource: Localization scans this folder at runtime, so a player can
       drop in their own .lang file (a new locale, or edits to an existing one) after install without
       rebuilding anything. -->
  <ItemGroup>
    <None Update="Localization\*.lang" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
