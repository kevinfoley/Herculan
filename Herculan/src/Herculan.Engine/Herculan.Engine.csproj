<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Herculan.Engine</RootNamespace>
    <AssemblyName>Herculan.Engine</AssemblyName>
    <!-- Silk.NET's vertex-attribute entry points take a void* offset; there is no managed overload. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- GLSL lives in its own files rather than in C# string constants; ShaderSource reads them
         back out of the assembly, so there is no path to resolve at runtime. -->
    <EmbeddedResource Include="Render\Shaders\*.glsl" />
  </ItemGroup>

  <ItemGroup>
    <!-- The locomotion tests build a synthetic flat HeightGrid, whose constructor is internal. -->
    <InternalsVisibleTo Include="Herculan.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HercWorks.Core\HercWorks.Core.csproj" />
    <ProjectReference Include="..\HercWorks.Disc\HercWorks.Disc.csproj" />
    <ProjectReference Include="..\HercWorks.Vol\HercWorks.Vol.csproj" />
    <ProjectReference Include="..\HercWorks.Video\HercWorks.Video.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <!-- Audio, per docs/herculan/planning.md. The Soft.Native package carries the OpenAL runtime, so
         a machine without one installed still gets sound; OpenAlBackend falls back to silence if
         even that fails to load. -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <!-- The hosts' own menus and panels, built through ScaledImGui. Nothing the game itself draws goes
         through ImGui: the cockpit and its HUD are the original's own art and its own font (Render/Cockpit,
         Content/HudFont). -->
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

</Project>
