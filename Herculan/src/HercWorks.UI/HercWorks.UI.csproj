<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HercWorks.UI</RootNamespace>
    <AssemblyName>HercWorksMDK</AssemblyName>
    <!-- The name Windows shows in Explorer's file properties and Task Manager. -->
    <AssemblyTitle>HercWorks CSharp</AssemblyTitle>
    <Product>HercWorks CSharp</Product>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HercWorks.Vol\HercWorks.Vol.csproj" />
    <ProjectReference Include="..\HercWorks.Core\HercWorks.Core.csproj" />
  </ItemGroup>

</Project>
