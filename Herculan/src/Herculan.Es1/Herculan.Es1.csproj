<Project Sdk="Microsoft.NET.Sdk">

  <!-- Metaltech: Earthsiege's game assembly, beside the core as docs/herculan/planning.md's "How the two games
       share code" sets out. It references the core's game-agnostic namespaces only; Es1BoundaryTests fails the
       test run when it reaches into ES2's game code, which still shares the Herculan.Engine assembly. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Herculan.Es1</RootNamespace>
    <AssemblyName>Herculan.Es1</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game's own GLSL, read through ShaderSource as the core's is. -->
    <EmbeddedResource Include="Render\Shaders\*.glsl" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Herculan.Engine\Herculan.Engine.csproj" />
    <ProjectReference Include="..\HercWorks.Core\HercWorks.Core.csproj" />
  </ItemGroup>

</Project>
